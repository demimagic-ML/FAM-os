diff --git a/bin/omarchy-agent b/bin/omarchy-agent
index 3e3b7a5..e826111 100755
--- a/bin/omarchy-agent
+++ b/bin/omarchy-agent
@@ -46,8 +46,10 @@ if [[ -z $agent ]]; then
   exit 1
 fi
 
