#!/bin/sh
# omarchy:summary=Launch FAM_OS in the current project or submit a durable goal
# omarchy:args=[--interactive] [--prompt <text>] [--goal] [--authority workspace|application_test|full_os] [text...]
# omarchy:examples=omarchy-fam --interactive | omarchy-fam --prompt "Review this project" | omarchy-fam --goal "Finish and test this application"
if [ "$#" -eq 0 ]; then
  exec fam-os agent --interactive --source omarchy-scratchpad --workspace "$PWD"
fi
if [ "$1" = "--interactive" ]; then
  shift
  exec fam-os agent --interactive --source omarchy-scratchpad --workspace "$PWD" "$@"
fi
if [ "$1" = "prompt" ] || [ "$1" = "--prompt" ]; then
  shift
fi
exec fam-os agent --source "${FAM_OMARCHY_SOURCE:-omarchy-agent-prompt}" --workspace "$PWD" "$@"
