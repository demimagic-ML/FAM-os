{
  "$defs": {
    "ChangeSetProposal": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "estimated_changed_bytes": {
          "type": "integer"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/FileOperation"
          },
          "type": "array"
        },
        "proposal_id": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "required_authorities": {
          "items": {
            "enum": [
              "observe",
              "propose",
              "modify",
              "execute",
              "network",
              "publish",
              "raw_shell",
              "host_admin",
              "secret_use",
              "global_install",
              "production_mutate",
              "policy_change",
              "protected_ref_write",
              "self_update"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "reversible": {
          "type": "boolean"
        },
        "snapshot_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "task_id",
        "snapshot_id",
        "created_at",
        "rationale",
        "operations",
        "required_authorities",
        "estimated_changed_bytes",
        "reversible",
        "contract_version"
      ],
      "type": "object"
    },
    "FileOperation": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "expected_before_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "create",
            "replace",
            "delete",
            "move"
          ],
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "reversible": {
          "type": "boolean"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation_id",
        "kind",
        "path",
        "expected_before_sha256",
        "content_sha256",
        "source_path",
        "reversible",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.change-set/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.engineering/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/ChangeSetProposal"
    },
    "schema_id": {
      "const": "fam.core.change-set/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Bounded engineering change-set proposal",
  "type": "object"
}
