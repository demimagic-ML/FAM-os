{
  "$defs": {
    "ExecutionPlan": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "fam.core/v1alpha1"
        },
        "entry_step_id": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "route": {
          "$ref": "#/$defs/RouteDecision"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PlanStep"
          },
          "type": "array"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/PlanTransition"
          },
          "type": "array"
        },
        "verification_required": {
          "type": "boolean"
        }
      },
      "required": [
        "plan_id",
        "request_id",
        "route",
        "entry_step_id",
        "steps",
        "transitions",
        "verification_required",
        "contract_version"
      ],
      "type": "object"
    },
    "PlanAuthorityBinding": {
      "additionalProperties": false,
      "properties": {
        "admission_id": {
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "admission_id",
        "valid_until"
      ],
      "type": "object"
    },
    "PlanEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "observation",
            "action_proposal",
            "action_confirmation",
            "action_result",
            "action_audit",
            "permission_expiry",
            "failure_reason",
            "failed_attempt",
            "repair_attempt",
            "escalation_attempt",
            "cancellation",
            "timeout",
            "degradation",
            "release_candidate",
            "verification_pass",
            "remote_execution",
            "remote_recovery"
          ],
          "type": "string"
        },
        "permission_grant_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_id": {
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "kind",
        "capability_id",
        "permission_grant_id"
      ],
      "type": "object"
    },
    "PlanInstanceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "authority_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanAuthorityBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_step_id": {
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/PlanLifecycleEvent"
          },
          "type": "array"
        },
        "instance_id": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ExecutionPlan"
        },
        "revision": {
          "type": "integer"
        },
        "terminal_disposition": {
          "anyOf": [
            {
              "enum": [
                "release",
                "withhold",
                "fail"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "instance_id",
        "plan",
        "current_step_id",
        "revision",
        "events",
        "terminal_disposition",
        "authority_binding"
      ],
      "type": "object"
    },
    "PlanLifecycleEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/PlanEvidenceReference"
          },
          "type": "array"
        },
        "kind": {
          "enum": [
            "started",
            "transitioned"
          ],
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "succeeded",
                "failed",
                "denied",
                "unavailable",
                "cancelled",
                "expired"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer"
        },
        "source_step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_step_id": {
          "type": "string"
        },
        "terminal_disposition": {
          "anyOf": [
            {
              "enum": [
                "release",
                "withhold",
                "fail"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "event_id",
        "revision",
        "occurred_at",
        "kind",
        "target_step_id",
        "source_step_id",
        "outcome",
        "terminal_disposition",
        "evidence_refs"
      ],
      "type": "object"
    },
    "PlanStep": {
      "additionalProperties": false,
      "properties": {
        "acceptance_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "capability_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "observe",
            "inference",
            "deterministic_tool",
            "prepare_action",
            "confirm_action",
            "execute_action",
            "verify",
            "finalize"
          ],
          "type": "string"
        },
        "step_id": {
          "type": "string"
        },
        "terminal_disposition": {
          "anyOf": [
            {
              "enum": [
                "release",
                "withhold",
                "fail"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "step_id",
        "kind",
        "description",
        "capability_ids",
        "acceptance_ids",
        "terminal_disposition"
      ],
      "type": "object"
    },
    "PlanTransition": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "denied",
            "unavailable",
            "cancelled",
            "expired"
          ],
          "type": "string"
        },
        "source_step_id": {
          "type": "string"
        },
        "target_step_id": {
          "type": "string"
        }
      },
      "required": [
        "source_step_id",
        "outcome",
        "target_step_id"
      ],
      "type": "object"
    },
    "RouteDecision": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "required_capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "route": {
          "enum": [
            "kernel",
            "code",
            "math",
            "retrieval"
          ],
          "type": "string"
        }
      },
      "required": [
        "route",
        "confidence",
        "reason",
        "required_capabilities"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.plan-instance/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/PlanInstanceSnapshot"
    },
    "schema_id": {
      "const": "fam.core.plan-instance/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Durable plan lifecycle snapshot",
  "type": "object"
}
