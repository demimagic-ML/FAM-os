{
  "$defs": {
    "DocumentationSource": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "content_sha256"
      ],
      "type": "object"
    },
    "GeneratedDocumentationReceipt": {
      "additionalProperties": false,
      "properties": {
        "authoritative_regeneration": {
          "type": "boolean"
        },
        "candidate_id": {
          "type": "string"
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "generated_at": {
          "format": "date-time",
          "type": "string"
        },
        "generator_recipe_id": {
          "type": "string"
        },
        "output_path": {
          "type": "string"
        },
        "output_sha256": {
          "type": "string"
        },
        "receipt_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/DocumentationSource"
          },
          "type": "array"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "request_id",
        "task_id",
        "candidate_id",
        "output_path",
        "output_sha256",
        "generator_recipe_id",
        "sources",
        "generated_at",
        "authoritative_regeneration",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.generated-documentation-receipt/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.engineering/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/GeneratedDocumentationReceipt"
    },
    "schema_id": {
      "const": "fam.core.generated-documentation-receipt/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Source and generator bound generated-content receipt",
  "type": "object"
}
