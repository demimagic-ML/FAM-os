{
  "$defs": {
    "ActionPreparationRequest": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "instance_id": {
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "permission_grant_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "resource_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "instance_id",
        "capability_id",
        "permission_grant_id",
        "summary",
        "parameters",
        "resource_uri",
        "expected_revision"
      ],
      "type": "object"
    },
    "ActionProposal": {
      "additionalProperties": false,
      "properties": {
        "confirmation": {
          "enum": [
            "not_required",
            "when_required",
            "always"
          ],
          "type": "string"
        },
        "postconditions": {
          "items": {
            "$ref": "#/$defs/ConditionRequirement"
          },
          "type": "array"
        },
        "preconditions": {
          "items": {
            "$ref": "#/$defs/ConditionRequirement"
          },
          "type": "array"
        },
        "preview": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "proposal_id": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ActionPreparationRequest"
        },
        "reversal_capability_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reversibility": {
          "enum": [
            "not_applicable",
            "reversible",
            "compensatable",
            "irreversible"
          ],
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "request",
        "preview",
        "reversibility",
        "confirmation",
        "postconditions",
        "preconditions",
        "reversal_capability_id"
      ],
      "type": "object"
    },
    "ActionResult": {
      "additionalProperties": false,
      "properties": {
        "after_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "before_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_at": {
          "format": "date-time",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApplicationFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "output": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "postcondition_evidence": {
          "items": {
            "$ref": "#/$defs/ConditionEvidence"
          },
          "type": "array"
        },
        "proposal_id": {
          "type": "string"
        },
        "reversal_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "verified",
            "denied",
            "precondition_failed",
            "execution_failed",
            "postcondition_failed",
            "cancelled"
          ],
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "status",
        "completed_at",
        "postcondition_evidence",
        "output",
        "before_revision",
        "after_revision",
        "reversal_token",
        "error"
      ],
      "type": "object"
    },
    "ApplicationFailure": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "permission_denied",
            "unavailable",
            "precondition_failed",
            "execution_failed",
            "postcondition_failed",
            "cancelled"
          ],
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "contract_version": {
          "const": "fam.application.failure/v1alpha1"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retry": {
          "enum": [
            "never",
            "immediate",
            "with_backoff",
            "after_user_action",
            "after_state_change"
          ],
          "type": "string"
        },
        "safe_message": {
          "type": "string"
        }
      },
      "required": [
        "category",
        "code",
        "safe_message",
        "retry",
        "evidence_ids",
        "contract_version"
      ],
      "type": "object"
    },
    "ConditionEvidence": {
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "verifier_id": {
          "type": "string"
        }
      },
      "required": [
        "condition_id",
        "verifier_id",
        "passed",
        "details"
      ],
      "type": "object"
    },
    "ConditionRequirement": {
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "verifier_id": {
          "type": "string"
        }
      },
      "required": [
        "condition_id",
        "verifier_id",
        "description"
      ],
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "PersistedActionRecord": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string"
        },
        "confirmation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract_version": {
          "const": "fam.product.restart-recovery/v1alpha1"
        },
        "idempotency_key": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        },
        "proposal": {
          "$ref": "#/$defs/ActionProposal"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "prepared",
            "awaiting_approval",
            "approved",
            "invoking",
            "uncertain",
            "reconciliation_required",
            "verified",
            "failed",
            "cancelled"
          ],
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "plan_id",
        "idempotency_key",
        "proposal",
        "state",
        "confirmation_id",
        "result",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.product.persisted-action/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.product.restart-recovery/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/PersistedActionRecord"
    },
    "schema_id": {
      "const": "fam.product.persisted-action/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Persisted application action state",
  "type": "object"
}
