{
  "$defs": {
    "IntegrationHealthCheck": {
      "additionalProperties": false,
      "properties": {
        "interval_seconds": {
          "type": "integer"
        },
        "kind": {
          "enum": [
            "tcp",
            "http",
            "signed_recipe"
          ],
          "type": "string"
        },
        "maximum_attempts": {
          "type": "integer"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "port_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "signed_recipe_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_seconds": {
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "port_name",
        "path",
        "signed_recipe_id",
        "interval_seconds",
        "timeout_seconds",
        "maximum_attempts"
      ],
      "type": "object"
    },
    "IntegrationPortBinding": {
      "additionalProperties": false,
      "properties": {
        "container_port": {
          "type": "integer"
        },
        "host_address": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "requested_host_port": {
          "type": "integer"
        }
      },
      "required": [
        "name",
        "container_port",
        "requested_host_port",
        "protocol",
        "host_address"
      ],
      "type": "object"
    },
    "IntegrationServiceSpec": {
      "additionalProperties": false,
      "properties": {
        "dependency_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "health_check": {
          "$ref": "#/$defs/IntegrationHealthCheck"
        },
        "image_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "image_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "process",
            "api",
            "browser",
            "container",
            "cluster_control_plane"
          ],
          "type": "string"
        },
        "launch_arguments": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/IntegrationPortBinding"
          },
          "type": "array"
        },
        "secret_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "service_id": {
          "type": "string"
        },
        "signed_launch_recipe_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "volumes": {
          "items": {
            "$ref": "#/$defs/IntegrationVolumeMount"
          },
          "type": "array"
        }
      },
      "required": [
        "service_id",
        "kind",
        "signed_launch_recipe_id",
        "launch_arguments",
        "image_ref",
        "image_sha256",
        "ports",
        "volumes",
        "health_check",
        "dependency_ids",
        "secret_refs"
      ],
      "type": "object"
    },
    "IntegrationVolumeMount": {
      "additionalProperties": false,
      "properties": {
        "candidate_relative_path": {
          "type": "string"
        },
        "maximum_bytes": {
          "type": "integer"
        },
        "mount_path": {
          "type": "string"
        },
        "read_only": {
          "type": "boolean"
        },
        "retain_artifacts": {
          "type": "boolean"
        },
        "volume_id": {
          "type": "string"
        }
      },
      "required": [
        "volume_id",
        "candidate_relative_path",
        "mount_path",
        "read_only",
        "maximum_bytes",
        "retain_artifacts"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.integration-service/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.engineering/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/IntegrationServiceSpec"
    },
    "schema_id": {
      "const": "fam.core.integration-service/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Bounded integration service specification",
  "type": "object"
}
