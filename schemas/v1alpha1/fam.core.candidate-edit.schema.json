{
  "$defs": {
    "CandidateArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "content_kind": {
          "enum": [
            "text",
            "binary"
          ],
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "metadata": {
          "items": {
            "$ref": "#/$defs/CandidateArtifactMetadata"
          },
          "type": "array"
        },
        "provenance": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer"
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_id",
        "content_kind",
        "media_type",
        "content_sha256",
        "size_bytes",
        "provenance",
        "source_name",
        "metadata"
      ],
      "type": "object"
    },
    "CandidateArtifactMetadata": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "CandidateEditRecord": {
      "additionalProperties": false,
      "properties": {
        "after_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateArtifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorization_decision_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "candidate_id": {
          "type": "string"
        },
        "changed_bytes": {
          "type": "integer"
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "definition_id": {
          "type": "string"
        },
        "edit_id": {
          "type": "string"
        },
        "failure_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "$ref": "#/$defs/CandidateOperation"
        },
        "principal_id": {
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "session_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "intent_recorded",
            "applied",
            "failed",
            "recovery_required"
          ],
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "edit_id",
        "definition_id",
        "task_id",
        "candidate_id",
        "session_id",
        "principal_id",
        "operation",
        "artifact",
        "authorization_decision_ids",
        "changed_bytes",
        "status",
        "revision",
        "recorded_at",
        "updated_at",
        "after_sha256",
        "failure_code",
        "contract_version"
      ],
      "type": "object"
    },
    "CandidateOperation": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "executable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_before_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "create_directory",
            "create_file",
            "patch_file",
            "move",
            "delete",
            "set_executable",
            "restore"
          ],
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation_id",
        "kind",
        "path",
        "expected_before_sha256",
        "artifact_id",
        "source_path",
        "executable"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.candidate-edit/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.engineering/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/CandidateEditRecord"
    },
    "schema_id": {
      "const": "fam.core.candidate-edit/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Intent-before-effect authorized candidate edit receipt",
  "type": "object"
}
