{
  "$defs": {
    "EngineeringTaskEnvelope": {
      "additionalProperties": false,
      "properties": {
        "authorities": {
          "items": {
            "enum": [
              "observe",
              "propose",
              "modify",
              "execute",
              "network",
              "publish",
              "raw_shell",
              "host_admin",
              "secret_use",
              "global_install",
              "production_mutate",
              "policy_change",
              "protected_ref_write",
              "self_update"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "checkpoint_policy": {
          "enum": [
            "none",
            "before_effects",
            "before_irreversible_effects",
            "every_changeset"
          ],
          "type": "string"
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "git_branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "git_remote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "grant_id": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "max_changed_bytes": {
          "type": "integer"
        },
        "max_changed_files": {
          "type": "integer"
        },
        "max_tool_runs": {
          "type": "integer"
        },
        "max_wall_seconds": {
          "type": "integer"
        },
        "network_hosts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "owner_id": {
          "type": "string"
        },
        "package_registries": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path_allowlist": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path_denylist": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "permitted_operations": {
          "items": {
            "enum": [
              "read",
              "create",
              "replace",
              "delete",
              "move",
              "run_tool",
              "manage_dependency",
              "manage_design",
              "git_write",
              "publish"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "task_id": {
          "type": "string"
        },
        "toolchains": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspace_roots": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "owner_id",
        "grant_id",
        "intent",
        "created_at",
        "expires_at",
        "workspace_roots",
        "authorities",
        "permitted_operations",
        "path_allowlist",
        "path_denylist",
        "toolchains",
        "network_hosts",
        "package_registries",
        "max_wall_seconds",
        "max_tool_runs",
        "max_changed_files",
        "max_changed_bytes",
        "git_remote",
        "git_branch",
        "checkpoint_policy",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.engineering-task/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.engineering/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/EngineeringTaskEnvelope"
    },
    "schema_id": {
      "const": "fam.core.engineering-task/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Owner-delegated engineering task",
  "type": "object"
}
