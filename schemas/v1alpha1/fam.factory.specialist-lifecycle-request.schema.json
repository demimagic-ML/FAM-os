{
  "$defs": {
    "FactorySpecialistLifecycleRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "manual_rollback",
            "forced_regression_rollback",
            "retire"
          ],
          "type": "string"
        },
        "contract_version": {
          "const": "fam.factory.specialist-lifecycle/v1alpha1"
        },
        "expected_lifecycle_revision": {
          "type": "integer"
        },
        "issued_at": {
          "format": "date-time",
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        },
        "regression_evidence_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_id": {
          "type": "string"
        },
        "remove_artifact": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string"
        },
        "request_sha256": {
          "type": "string"
        },
        "target_release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "request_id",
        "action",
        "release_id",
        "target_release_id",
        "expected_lifecycle_revision",
        "reason_code",
        "regression_evidence_sha256",
        "remove_artifact",
        "issued_at",
        "request_sha256",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.factory.specialist-lifecycle-request/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.factory.specialist-lifecycle/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/FactorySpecialistLifecycleRequest"
    },
    "schema_id": {
      "const": "fam.factory.specialist-lifecycle-request/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Durable confirmed rollback or retirement authority",
  "type": "object"
}
