{
  "$defs": {
    "RemoteContextEnvelope": {
      "additionalProperties": false,
      "properties": {
        "content_bytes": {
          "type": "integer"
        },
        "content_sha256": {
          "type": "string"
        },
        "context_id": {
          "type": "string"
        },
        "contract_version": {
          "const": "fam.fabric.minimum-context/v1alpha1"
        },
        "descriptor": {
          "$ref": "#/$defs/RemoteTaskDescriptor"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "type": "string"
        },
        "purpose_id": {
          "type": "string"
        },
        "raw_fragments": {
          "items": {
            "$ref": "#/$defs/RemoteRawContextFragment"
          },
          "type": "array"
        },
        "receiver_device_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "sender_device_id": {
          "type": "string"
        },
        "sensitivity": {
          "enum": [
            "public",
            "private",
            "restricted"
          ],
          "type": "string"
        },
        "signature_base64": {
          "type": "string"
        },
        "target_expert_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "context_id",
        "request_id",
        "sender_device_id",
        "receiver_device_id",
        "target_expert_id",
        "purpose_id",
        "workspace_id",
        "sensitivity",
        "descriptor",
        "raw_fragments",
        "content_bytes",
        "content_sha256",
        "issued_at",
        "expires_at",
        "signature_base64",
        "contract_version"
      ],
      "type": "object"
    },
    "RemoteRawContextFragment": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "fragment_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "prompt",
            "file_excerpt",
            "memory",
            "retrieval"
          ],
          "type": "string"
        },
        "source_sha256": {
          "type": "string"
        }
      },
      "required": [
        "fragment_id",
        "kind",
        "source_sha256",
        "content",
        "content_sha256"
      ],
      "type": "object"
    },
    "RemoteTaskDescriptor": {
      "additionalProperties": false,
      "properties": {
        "assurance_id": {
          "type": "string"
        },
        "capability_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "intent_id": {
          "type": "string"
        },
        "maximum_output_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "intent_id",
        "capability_ids",
        "assurance_id",
        "maximum_output_bytes"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.fabric.minimum-context/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.fabric.minimum-context/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/RemoteContextEnvelope"
    },
    "schema_id": {
      "const": "fam.fabric.minimum-context/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Signed exact-byte minimum remote context",
  "type": "object"
}
