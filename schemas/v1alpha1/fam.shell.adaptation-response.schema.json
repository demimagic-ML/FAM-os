        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "peak_temperature_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_conformant": {
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "request_id_sha256": {
          "type": "string"
