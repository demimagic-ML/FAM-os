  "$id": "https://schemas.fam-os.local/fam.shell.adaptation-response/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.shell.adaptation/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/ShellAdaptationResponse"
    },
    "schema_id": {
      "const": "fam.shell.adaptation-response/v1alpha1"
    }
