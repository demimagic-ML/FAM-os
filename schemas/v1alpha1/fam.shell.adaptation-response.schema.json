    "AdaptationHealthSummary": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "fam.adaptation.live-control/v1alpha1"
        },
        "max_temperature_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
