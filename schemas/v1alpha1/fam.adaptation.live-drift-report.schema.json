{
  "$defs": {
    "AdaptationHealthSummary": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "fam.adaptation.live-control/v1alpha1"
        },
        "max_temperature_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "p95_latency_seconds": {
          "type": "number"
        },
        "policy_violation_count": {
          "type": "integer"
        },
        "sample_count": {
          "type": "integer"
        },
        "snapshot_id": {
          "type": "string"
        },
        "source_evidence_sha256": {
          "type": "string"
        },
        "source_sample_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "thermal_sample_count": {
          "type": "integer"
        },
        "verification_quality": {
          "type": "number"
        },
        "workflow_id": {
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "workflow_id",
        "sample_count",
        "verification_quality",
        "p95_latency_seconds",
        "max_temperature_c",
        "thermal_sample_count",
        "policy_violation_count",
        "source_sample_ids",
        "source_evidence_sha256",
        "contract_version"
      ],
      "type": "object"
    },
    "LiveAdaptationDriftReport": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/AdaptationHealthSummary"
        },
        "candidate": {
          "$ref": "#/$defs/AdaptationHealthSummary"
        },
        "contract_version": {
          "const": "fam.adaptation.live-control/v1alpha1"
        },
        "drifted": {
          "type": "boolean"
        },
        "evaluated_at": {
          "format": "date-time",
          "type": "string"
        },
        "evaluated_dimensions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "local_only": {
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "report_id": {
          "type": "string"
        },
        "unavailable_dimensions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workflow_id": {
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "workflow_id",
        "baseline",
        "candidate",
        "evaluated_dimensions",
        "unavailable_dimensions",
        "reason_codes",
        "drifted",
        "evaluated_at",
        "local_only",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.adaptation.live-drift-report/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.adaptation.live-control/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/LiveAdaptationDriftReport"
    },
    "schema_id": {
      "const": "fam.adaptation.live-drift-report/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Quality thermal latency and policy drift report",
  "type": "object"
}
