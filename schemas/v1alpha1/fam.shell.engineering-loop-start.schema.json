    "EngineeringLoopBudget": {
      "additionalProperties": false,
      "properties": {
        "maximum_commands": {
          "type": "integer"
        },
        "maximum_files": {
          "type": "integer"
        },
        "maximum_network_bytes": {
          "type": "integer"
        },
        "maximum_storage_bytes": {
          "type": "integer"
        },
        "maximum_tokens": {
          "type": "integer"
        },
        "maximum_wall_seconds": {
          "type": "integer"
        },
        "used_commands": {
          "type": "integer"
        },
        "used_files": {
          "type": "integer"
        },
        "used_network_bytes": {
          "type": "integer"
        },
        "used_storage_bytes": {
          "type": "integer"
        },
        "used_tokens": {
          "type": "integer"
        },
        "used_wall_seconds": {
          "type": "integer"
        }
      },
      "required": [
        "maximum_tokens",
        "maximum_wall_seconds",
        "maximum_commands",
        "maximum_network_bytes",
        "maximum_files",
        "maximum_storage_bytes",
        "used_tokens",
        "used_wall_seconds",
        "used_commands",
        "used_network_bytes",
        "used_files",
        "used_storage_bytes"
      ],
      "type": "object"
    },
    "EngineeringTaskDefinition": {
      "additionalProperties": false,
      "properties": {
        "acceptance_policy_id": {
          "type": "string"
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "definition_id": {
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/EngineeringTaskEnvelope"
        },
        "task_sha256": {
          "type": "string"
        }
      },
      "required": [
        "definition_id",
        "task",
        "acceptance_policy_id",
        "created_at",
        "task_sha256",
        "contract_version"
      ],
      "type": "object"
    },
    "EngineeringTaskEnvelope": {
      "additionalProperties": false,
      "properties": {
        "authorities": {
          "items": {
            "enum": [
              "observe",
              "propose",
              "modify",
              "execute",
              "network",
              "publish",
              "raw_shell",
              "host_admin",
              "secret_use",
              "global_install",
              "production_mutate",
              "policy_change",
              "protected_ref_write",
              "self_update"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "checkpoint_policy": {
          "enum": [
            "none",
            "before_effects",
            "before_irreversible_effects",
            "every_changeset"
          ],
          "type": "string"
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "git_branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "git_remote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "grant_id": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "max_changed_bytes": {
          "type": "integer"
        },
        "max_changed_files": {
          "type": "integer"
        },
        "max_tool_runs": {
          "type": "integer"
        },
        "max_wall_seconds": {
          "type": "integer"
        },
        "network_hosts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "owner_id": {
          "type": "string"
        },
        "package_registries": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path_allowlist": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path_denylist": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "permitted_operations": {
          "items": {
            "enum": [
              "read",
              "create",
              "replace",
              "delete",
              "move",
              "run_tool",
              "manage_dependency",
              "manage_design",
              "git_write",
              "publish"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "task_id": {
          "type": "string"
        },
        "toolchains": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspace_roots": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "owner_id",
        "grant_id",
        "intent",
        "created_at",
        "expires_at",
        "workspace_roots",
        "authorities",
        "permitted_operations",
        "path_allowlist",
        "path_denylist",
        "toolchains",
        "network_hosts",
        "package_registries",
        "max_wall_seconds",
        "max_tool_runs",
        "max_changed_files",
        "max_changed_bytes",
        "git_remote",
        "git_branch",
        "checkpoint_policy",
        "contract_version"
      ],
      "type": "object"
    },
    "ShellEngineeringLoopStartRequest": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/EngineeringLoopBudget"
        },
        "confirmed": {
          "type": "boolean"
        },
        "contract_version": {
          "const": "fam.shell.engineering-loop/v1alpha1"
        },
        "definition": {
          "$ref": "#/$defs/EngineeringTaskDefinition"
        },
        "owner_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "owner_id",
        "definition",
        "budget",
        "confirmed",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.shell.engineering-loop-start/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.shell.engineering-loop/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/ShellEngineeringLoopStartRequest"
    },
    "schema_id": {
      "const": "fam.shell.engineering-loop-start/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Confirmed persistent engineering lifecycle start",
  "type": "object"
}
