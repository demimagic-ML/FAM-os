{
  "$defs": {
    "CandidateArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "content_kind": {
          "enum": [
            "text",
            "binary"
          ],
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "metadata": {
          "items": {
            "$ref": "#/$defs/CandidateArtifactMetadata"
          },
          "type": "array"
        },
        "provenance": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer"
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_id",
        "content_kind",
        "media_type",
        "content_sha256",
        "size_bytes",
        "provenance",
        "source_name",
        "metadata"
      ],
      "type": "object"
    },
    "CandidateArtifactMetadata": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "CandidateOperation": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "executable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_before_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "create_directory",
            "create_file",
            "patch_file",
            "move",
            "delete",
            "set_executable",
            "restore"
          ],
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation_id",
        "kind",
        "path",
        "expected_before_sha256",
        "artifact_id",
        "source_path",
        "executable"
      ],
      "type": "object"
    },
    "ShellEngineeringCandidateEditRequest": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateArtifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmed": {
          "type": "boolean"
        },
        "content_base64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract_version": {
          "const": "fam.shell.engineering-loop/v1alpha1"
        },
        "edit_id": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/CandidateOperation"
        },
        "owner_id": {
          "type": "string"
        },
        "principal_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "owner_id",
        "task_id",
        "edit_id",
        "session_id",
        "principal_id",
        "operation",
        "artifact",
        "content_base64",
        "confirmed",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.shell.engineering-candidate-edit/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.shell.engineering-loop/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/ShellEngineeringCandidateEditRequest"
    },
    "schema_id": {
      "const": "fam.shell.engineering-candidate-edit/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Confirmed bounded candidate edit with transient content",
  "type": "object"
}
