{
  "$defs": {
    "RemoteExecutionAuthority": {
      "additionalProperties": false,
      "properties": {
        "confirmed": {
          "type": "boolean"
        },
        "contract_version": {
          "const": "fam.fabric.remote-execution/v1alpha1"
        },
        "enrollment_id": {
          "type": "string"
        },
        "expected_privacy_revision": {
          "type": "integer"
        },
        "maximum_context_bytes": {
          "type": "integer"
        },
        "maximum_output_bytes": {
          "type": "integer"
        },
        "purpose_id": {
          "type": "string"
        },
        "sensitivity": {
          "enum": [
            "public",
            "private",
            "restricted"
          ],
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "enrollment_id",
        "expected_privacy_revision",
        "purpose_id",
        "workspace_id",
        "sensitivity",
        "maximum_context_bytes",
        "maximum_output_bytes",
        "confirmed",
        "contract_version"
      ],
      "type": "object"
    },
    "ShellAskCommand": {
      "additionalProperties": false,
      "properties": {
        "contexts": {
          "items": {
            "$ref": "#/$defs/ShellContext"
          },
          "type": "array"
        },
        "contract_version": {
          "const": "fam.shell/v1alpha1"
        },
        "memory_session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt": {
          "type": "string"
        },
        "remote_authority": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteExecutionAuthority"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id": {
          "type": "string"
        },
        "required_capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "verification_required": {
          "type": "boolean"
        }
      },
      "required": [
        "request_id",
        "prompt",
        "contexts",
        "required_capabilities",
        "verification_required",
        "contract_version",
        "memory_session_id",
        "remote_authority"
      ],
      "type": "object"
    },
    "ShellContext": {
      "additionalProperties": false,
      "properties": {
        "capability_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "context_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "application",
            "file",
            "selection",
            "uri"
          ],
          "type": "string"
        },
        "resource_ref": {
          "type": "string"
        }
      },
      "required": [
        "context_id",
        "kind",
        "resource_ref",
        "display_name",
        "capability_ids"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.shell.ask/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.shell/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/ShellAskCommand"
    },
    "schema_id": {
      "const": "fam.shell.ask/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "FAM Shell ask command",
  "type": "object"
}
