{
  "$defs": {
    "DependencyChange": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "add",
            "update",
            "remove"
          ],
          "type": "string"
        },
        "current_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ecosystem": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "registry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ecosystem",
        "package",
        "action",
        "current_version",
        "requested_version",
        "registry"
      ],
      "type": "object"
    },
    "DependencyPlan": {
      "additionalProperties": false,
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/DependencyChange"
          },
          "type": "array"
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "license_check_required": {
          "type": "boolean"
        },
        "lockfile_path": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        },
        "required_authorities": {
          "items": {
            "enum": [
              "observe",
              "propose",
              "modify",
              "execute",
              "network",
              "publish",
              "raw_shell",
              "host_admin",
              "secret_use",
              "global_install",
              "production_mutate",
              "policy_change",
              "protected_ref_write",
              "self_update"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "task_id": {
          "type": "string"
        },
        "vulnerability_scan_required": {
          "type": "boolean"
        }
      },
      "required": [
        "plan_id",
        "task_id",
        "lockfile_path",
        "changes",
        "required_authorities",
        "vulnerability_scan_required",
        "license_check_required",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.dependency-plan/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.engineering/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/DependencyPlan"
    },
    "schema_id": {
      "const": "fam.core.dependency-plan/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Auditable dependency change plan",
  "type": "object"
}
