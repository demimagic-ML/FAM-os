{
  "$defs": {
    "RemoteContextSendRequest": {
      "additionalProperties": false,
      "properties": {
        "capability_declaration_id": {
          "type": "string"
        },
        "confirmed": {
          "type": "boolean"
        },
        "contract_version": {
          "const": "fam.fabric.minimum-context/v1alpha1"
        },
        "descriptor": {
          "$ref": "#/$defs/RemoteTaskDescriptor"
        },
        "enrollment_id": {
          "type": "string"
        },
        "expected_privacy_revision": {
          "type": "integer"
        },
        "purpose_id": {
          "type": "string"
        },
        "raw_fragments": {
          "items": {
            "$ref": "#/$defs/RemoteRawContextFragment"
          },
          "type": "array"
        },
        "request_id": {
          "type": "string"
        },
        "sensitivity": {
          "enum": [
            "public",
            "private",
            "restricted"
          ],
          "type": "string"
        },
        "target_expert_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "enrollment_id",
        "target_expert_id",
        "capability_declaration_id",
        "expected_privacy_revision",
        "purpose_id",
        "workspace_id",
        "sensitivity",
        "descriptor",
        "raw_fragments",
        "confirmed",
        "contract_version"
      ],
      "type": "object"
    },
    "RemoteRawContextFragment": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "fragment_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "prompt",
            "file_excerpt",
            "memory",
            "retrieval"
          ],
          "type": "string"
        },
        "source_sha256": {
          "type": "string"
        }
      },
      "required": [
        "fragment_id",
        "kind",
        "source_sha256",
        "content",
        "content_sha256"
      ],
      "type": "object"
    },
    "RemoteTaskDescriptor": {
      "additionalProperties": false,
      "properties": {
        "assurance_id": {
          "type": "string"
        },
        "capability_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "intent_id": {
          "type": "string"
        },
        "maximum_output_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "intent_id",
        "capability_ids",
        "assurance_id",
        "maximum_output_bytes"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.fabric.context-send-request/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.fabric.minimum-context/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/RemoteContextSendRequest"
    },
    "schema_id": {
      "const": "fam.fabric.context-send-request/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Local authorized remote context request",
  "type": "object"
}
