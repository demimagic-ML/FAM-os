          "type": "array"
        },
        "rollback_complete": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "applied",
            "rolled_back",
            "conflict",
            "recovery_required"
          ],
          "type": "string"
        },
        "transaction_id": {
          "type": "string"
        }
      },
      "required": [
        "transaction_id",
        "candidate_id",
