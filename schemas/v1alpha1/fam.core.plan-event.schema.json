{
  "$defs": {
    "PlanEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "observation",
            "action_proposal",
            "action_confirmation",
            "action_result",
            "action_audit",
            "permission_expiry",
            "failure_reason",
            "failed_attempt",
            "repair_attempt",
            "escalation_attempt",
            "cancellation",
            "timeout",
            "degradation",
            "release_candidate",
            "verification_pass",
            "remote_execution",
            "remote_recovery"
          ],
          "type": "string"
        },
        "permission_grant_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_id": {
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "kind",
        "capability_id",
        "permission_grant_id"
      ],
      "type": "object"
    },
    "PlanLifecycleEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/PlanEvidenceReference"
          },
          "type": "array"
        },
        "kind": {
          "enum": [
            "started",
            "transitioned"
          ],
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "succeeded",
                "failed",
                "denied",
                "unavailable",
                "cancelled",
                "expired"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer"
        },
        "source_step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_step_id": {
          "type": "string"
        },
        "terminal_disposition": {
          "anyOf": [
            {
              "enum": [
                "release",
                "withhold",
                "fail"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "event_id",
        "revision",
        "occurred_at",
        "kind",
        "target_step_id",
        "source_step_id",
        "outcome",
        "terminal_disposition",
        "evidence_refs"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.plan-event/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/PlanLifecycleEvent"
    },
    "schema_id": {
      "const": "fam.core.plan-event/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Durable plan lifecycle event",
  "type": "object"
}
