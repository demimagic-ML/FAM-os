{
  "$defs": {
    "RuntimeDiagnosticLimits": {
      "additionalProperties": false,
      "properties": {
        "artifact_bytes": {
          "type": "integer"
        },
        "cpu_seconds": {
          "type": "integer"
        },
        "memory_bytes": {
          "type": "integer"
        },
        "output_bytes": {
          "type": "integer"
        },
        "process_limit": {
          "type": "integer"
        },
        "sample_limit": {
          "type": "integer"
        },
        "temporary_file_bytes": {
          "type": "integer"
        },
        "unbounded_virtual_address_space": {
          "type": "boolean"
        },
        "wall_seconds": {
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "cpu_seconds",
        "memory_bytes",
        "process_limit",
        "output_bytes",
        "artifact_bytes",
        "sample_limit",
        "temporary_file_bytes",
        "unbounded_virtual_address_space"
      ],
      "type": "object"
    },
    "RuntimeDiagnosticRequest": {
      "additionalProperties": false,
      "properties": {
        "allowed_environment_keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "artifact_kinds": {
          "items": {
            "enum": [
              "stack_trace",
              "crash_dump",
              "trace",
              "profile",
              "race_report",
              "leak_report",
              "performance_sample"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "baseline_artifact_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_value_microunits": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_id": {
          "type": "string"
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "grant_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "stack_trace",
            "crash_dump",
            "trace",
            "cpu_profile",
            "memory_profile",
            "race_detection",
            "leak_detection",
            "performance_regression"
          ],
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/RuntimeDiagnosticLimits"
        },
        "maximum_regression_ppm": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "network_destinations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "network_mode": {
          "enum": [
            "denied",
            "allowlist_proxy"
          ],
          "type": "string"
        },
        "performance_mode": {
          "enum": [
            "not_applicable",
            "baseline_capture",
            "comparison"
          ],
          "type": "string"
        },
        "phase": {
          "enum": [
            "baseline",
            "candidate",
            "postapply"
          ],
          "type": "string"
        },
        "principal_id": {
          "type": "string"
        },
        "recipe_payload_sha256": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "required_authority": {
          "enum": [
            "observe",
            "propose",
            "modify",
            "execute",
            "network",
            "publish",
            "raw_shell",
            "host_admin",
            "secret_use",
            "global_install",
            "production_mutate",
            "policy_change",
            "protected_ref_write",
            "self_update"
          ],
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "signed_recipe_id": {
          "type": "string"
        },
        "signed_recipe_version": {
          "type": "string"
        },
        "target_argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "task_id",
        "candidate_id",
        "grant_id",
        "principal_id",
        "session_id",
        "phase",
        "signed_recipe_id",
        "signed_recipe_version",
        "recipe_payload_sha256",
        "kind",
        "target_argv",
        "allowed_environment_keys",
        "artifact_kinds",
        "limits",
        "network_mode",
        "network_destinations",
        "created_at",
        "baseline_artifact_sha256",
        "baseline_value_microunits",
        "maximum_regression_ppm",
        "required_authority",
        "performance_mode",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.runtime-diagnostic-request/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.engineering/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/RuntimeDiagnosticRequest"
    },
    "schema_id": {
      "const": "fam.core.runtime-diagnostic-request/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Bounded signed runtime diagnostic request",
  "type": "object"
}
