{
  "$defs": {
    "RuntimeDiagnosticQualification": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "diagnostic": {
          "type": "string"
        },
        "installed_release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "stack_trace",
            "crash_dump",
            "trace",
            "cpu_profile",
            "memory_profile",
            "race_detection",
            "leak_detection",
            "performance_regression"
          ],
          "type": "string"
        },
        "negative_receipt_id": {
          "type": "string"
        },
        "physically_executed": {
          "type": "boolean"
        },
        "positive_receipt_id": {
          "type": "string"
        },
        "qualification_id": {
          "type": "string"
        },
        "qualified_at": {
          "format": "date-time",
          "type": "string"
        },
        "signed_recipe_id": {
          "type": "string"
        },
        "signed_recipe_version": {
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unavailable"
          ],
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        }
      },
      "required": [
        "qualification_id",
        "kind",
        "signed_recipe_id",
        "signed_recipe_version",
        "tool_version",
        "positive_receipt_id",
        "negative_receipt_id",
        "status",
        "physically_executed",
        "qualified_at",
        "installed_release_id",
        "diagnostic",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.runtime-diagnostic-qualification/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.engineering/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/RuntimeDiagnosticQualification"
    },
    "schema_id": {
      "const": "fam.core.runtime-diagnostic-qualification/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Physical positive and negative diagnostic qualification",
  "type": "object"
}
