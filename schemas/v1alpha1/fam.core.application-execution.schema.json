      "type": "object"
    },
    "ActionProposal": {
      "additionalProperties": false,
      "properties": {
        "confirmation": {
          "enum": [
            "not_required",
            "when_required",
            "always"
          ],
          "type": "string"
        },
        "postconditions": {
          "items": {
            "$ref": "#/$defs/ConditionRequirement"
          },
          "type": "array"
        },
        "preconditions": {
          "items": {
            "$ref": "#/$defs/ConditionRequirement"
          },
          "type": "array"
        },
        "preview": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
