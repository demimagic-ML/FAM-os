          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "postcondition_evidence": {
          "items": {
            "$ref": "#/$defs/ConditionEvidence"
          },
          "type": "array"
        },
        "proposal_id": {
          "type": "string"
        },
        "reversal_token": {
          "anyOf": [
            {
              "type": "string"
