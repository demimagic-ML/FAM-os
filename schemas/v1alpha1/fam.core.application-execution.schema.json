        "proposal_id": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ActionPreparationRequest"
        },
        "reversal_capability_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reversibility": {
          "enum": [
            "not_applicable",
            "reversible",
            "compensatable",
            "irreversible"
