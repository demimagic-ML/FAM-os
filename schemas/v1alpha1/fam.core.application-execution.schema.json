  "$id": "https://schemas.fam-os.local/fam.core.application-execution/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.application-execution/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/ApplicationExecutionRecord"
    },
    "schema_id": {
      "const": "fam.core.application-execution/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Restart-safe application execution",
  "type": "object"
}
