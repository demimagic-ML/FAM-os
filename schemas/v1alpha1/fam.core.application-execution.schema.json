            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decision",
        "metrics",
        "contract_version"
      ],
      "type": "object"
    },
    "TaskRequest": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "fam.core/v1alpha1"
        },
        "prompt": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "required_capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
