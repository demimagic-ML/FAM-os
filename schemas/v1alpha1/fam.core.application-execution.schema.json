          "$ref": "#/$defs/RoutingResult"
        }
      },
      "required": [
        "admitted",
        "routing"
      ],
      "type": "object"
    },
    "RoutingResult": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "fam.routing/v1alpha1"
