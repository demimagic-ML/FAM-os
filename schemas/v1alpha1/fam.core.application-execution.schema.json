          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "route": {
          "enum": [
            "kernel",
            "code",
            "math",
            "retrieval"
          ],
          "type": "string"
        }
      },
      "required": [
        "route",
        "confidence",
        "reason",
        "required_capabilities"
      ],
      "type": "object"
