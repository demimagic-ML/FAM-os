      "required": [
        "proposal_id",
        "status",
        "completed_at",
        "postcondition_evidence",
        "output",
        "before_revision",
        "after_revision",
        "reversal_token",
        "error"
      ],
      "type": "object"
    },
    "AdmittedTaskRequest": {
      "additionalProperties": false,
      "properties": {
        "admission_id": {
          "type": "string"
