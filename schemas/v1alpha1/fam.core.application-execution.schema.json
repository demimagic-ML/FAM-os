        "decided_at": {
          "format": "date-time",
          "type": "string"
        },
        "decided_by": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "approved",
            "denied"
          ],
          "type": "string"
        },
        "permission_grant_id": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "confirmation_id",
        "proposal_id",
        "permission_grant_id",
        "decision",
        "decided_by",
        "decided_at",
        "reason"
      ],
      "type": "object"
    },
    "ActionPreparationRequest": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "type": "string"
