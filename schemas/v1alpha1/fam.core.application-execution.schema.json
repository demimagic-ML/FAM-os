        "permission_grant_id": {
          "type": "string"
        },
        "proposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionProposal"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id": {
          "type": "string"
        },
        "resource_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reversal_session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
