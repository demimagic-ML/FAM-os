        "instance_id",
        "request_id",
        "routed",
        "application_instance_id",
        "resource_uri",
        "permission_grant_id",
        "state",
        "revision",
        "observations",
        "proposal",
        "confirmation",
        "action_result",
        "reversal_source_session_id",
        "reversal_session_id",
