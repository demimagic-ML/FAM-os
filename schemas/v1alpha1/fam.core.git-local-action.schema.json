{
  "$defs": {
    "GitLocalAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string"
        },
        "approved_change_set_id": {
          "type": "string"
        },
        "branch_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "expected_head_object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "create_branch",
            "stage_paths",
            "commit",
            "restore_paths"
          ],
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repository_root": {
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "verification_evidence_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "action_id",
        "task_id",
        "repository_root",
        "kind",
        "branch_name",
        "paths",
        "message",
        "approved_change_set_id",
        "verification_evidence_ids",
        "expected_head_object_id",
        "requested_at",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.git-local-action/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.engineering/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/GitLocalAction"
    },
    "schema_id": {
      "const": "fam.core.git-local-action/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Exact-path local branch stage commit or restore action",
  "type": "object"
}
