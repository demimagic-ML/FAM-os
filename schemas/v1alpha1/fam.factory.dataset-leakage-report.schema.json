{
  "$defs": {
    "DatasetLeakageFinding": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "contract_version": {
          "const": "fam.factory.sealed-dataset/v1alpha1"
        },
        "finding_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "source_family_crossed_partitions",
            "exact_cross_partition",
            "near_cross_partition"
          ],
          "type": "string"
        },
        "left_record_id": {
          "type": "string"
        },
        "right_record_id": {
          "type": "string"
        },
        "similarity_ppm": {
          "type": "integer"
        }
      },
      "required": [
        "finding_id",
        "kind",
        "left_record_id",
        "right_record_id",
        "similarity_ppm",
        "blocking",
        "contract_version"
      ],
      "type": "object"
    },
    "DatasetLeakageReport": {
      "additionalProperties": false,
      "properties": {
        "candidate_dataset_id": {
          "type": "string"
        },
        "contract_version": {
          "const": "fam.factory.sealed-dataset/v1alpha1"
        },
        "evaluated_at": {
          "format": "date-time",
          "type": "string"
        },
        "exact_duplicates_removed": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/DatasetLeakageFinding"
          },
          "type": "array"
        },
        "input_record_count": {
          "type": "integer"
        },
        "near_duplicate_threshold_ppm": {
          "type": "integer"
        },
        "near_duplicates_removed": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "passed": {
          "type": "boolean"
        },
        "report_id": {
          "type": "string"
        },
        "report_sha256": {
          "type": "string"
        },
        "retained_record_count": {
          "type": "integer"
        }
      },
      "required": [
        "report_id",
        "candidate_dataset_id",
        "input_record_count",
        "retained_record_count",
        "exact_duplicates_removed",
        "near_duplicates_removed",
        "near_duplicate_threshold_ppm",
        "findings",
        "evaluated_at",
        "passed",
        "report_sha256",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.factory.dataset-leakage-report/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.factory.sealed-dataset/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/DatasetLeakageReport"
    },
    "schema_id": {
      "const": "fam.factory.dataset-leakage-report/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Immutable exact and near-duplicate leakage evidence",
  "type": "object"
}
