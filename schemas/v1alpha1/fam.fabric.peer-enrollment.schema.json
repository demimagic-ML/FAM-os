{
  "$defs": {
    "DeviceIdentity": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "fingerprint_sha256": {
          "type": "string"
        },
        "public_key_base64": {
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "display_name",
        "public_key_base64",
        "fingerprint_sha256"
      ],
      "type": "object"
    },
    "DevicePairingApproval": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "type": "string"
        },
        "approved_at": {
          "format": "date-time",
          "type": "string"
        },
        "ceremony_sha256": {
          "type": "string"
        },
        "contract_version": {
          "const": "fam.fabric.device-pairing/v1alpha1"
        },
        "local_identity": {
          "$ref": "#/$defs/DeviceIdentity"
        },
        "local_offer_id": {
          "type": "string"
        },
        "owner_id": {
          "type": "string"
        },
        "peer_endpoint": {
          "$ref": "#/$defs/PeerEndpoint"
        },
        "peer_identity": {
          "$ref": "#/$defs/DeviceIdentity"
        },
        "peer_identity_certificate_base64": {
          "type": "string"
        },
        "peer_offer_id": {
          "type": "string"
        },
        "signature_base64": {
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "owner_id",
        "local_identity",
        "peer_identity",
        "peer_identity_certificate_base64",
        "peer_endpoint",
        "local_offer_id",
        "peer_offer_id",
        "ceremony_sha256",
        "approved_at",
        "signature_base64",
        "contract_version"
      ],
      "type": "object"
    },
    "PeerEndpoint": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      },
      "required": [
        "host",
        "port"
      ],
      "type": "object"
    },
    "PeerEnrollmentRecord": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "$ref": "#/$defs/DevicePairingApproval"
        },
        "contract_version": {
          "const": "fam.fabric.peer-enrollment/v1alpha1"
        },
        "enrolled_at": {
          "format": "date-time",
          "type": "string"
        },
        "enrollment_id": {
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "revision": {
          "type": "integer"
        },
        "revoked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "active",
            "revoked"
          ],
          "type": "string"
        }
      },
      "required": [
        "enrollment_id",
        "approval",
        "state",
        "revision",
        "enrolled_at",
        "revoked_at",
        "reason_codes",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.fabric.peer-enrollment/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.fabric.peer-enrollment/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/PeerEnrollmentRecord"
    },
    "schema_id": {
      "const": "fam.fabric.peer-enrollment/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Durable owner-approved peer enrollment",
  "type": "object"
}
