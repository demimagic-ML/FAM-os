{
  "$defs": {
    "GitOperation": {
      "additionalProperties": false,
      "properties": {
        "commit_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "force": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "create_branch",
            "commit",
            "merge",
            "rebase",
            "tag",
            "push",
            "open_change_request"
          ],
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "remote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository_root": {
          "type": "string"
        },
        "required_authorities": {
          "items": {
            "enum": [
              "observe",
              "propose",
              "modify",
              "execute",
              "network",
              "publish",
              "raw_shell",
              "host_admin",
              "secret_use",
              "global_install",
              "production_mutate",
              "policy_change",
              "protected_ref_write",
              "self_update"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_ref": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "task_id",
        "kind",
        "repository_root",
        "remote",
        "source_ref",
        "target_ref",
        "commit_sha256",
        "message",
        "required_authorities",
        "force",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.git-operation/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.engineering/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/GitOperation"
    },
    "schema_id": {
      "const": "fam.core.git-operation/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Authorized Git operation",
  "type": "object"
}
