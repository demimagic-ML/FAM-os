{
  "$defs": {
    "EngineeringResourceImpact": {
      "additionalProperties": false,
      "properties": {
        "max_changed_bytes": {
          "type": "integer"
        },
        "max_changed_files": {
          "type": "integer"
        },
        "max_network_bytes": {
          "type": "integer"
        },
        "max_processes": {
          "type": "integer"
        },
        "max_tool_runs": {
          "type": "integer"
        },
        "max_wall_seconds": {
          "type": "integer"
        }
      },
      "required": [
        "max_wall_seconds",
        "max_tool_runs",
        "max_processes",
        "max_changed_files",
        "max_changed_bytes",
        "max_network_bytes"
      ],
      "type": "object"
    },
    "PostgreSQLIntegrationVerificationPlan": {
      "additionalProperties": false,
      "properties": {
        "approved_changeset_id": {
          "type": "string"
        },
        "backup_required": {
          "type": "boolean"
        },
        "candidate_id": {
          "type": "string"
        },
        "connection_secret_ref": {
          "type": "string"
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "database_name": {
          "type": "string"
        },
        "environment_id": {
          "type": "string"
        },
        "exact_host_id": {
          "type": "string"
        },
        "execution_resource_impact": {
          "$ref": "#/$defs/EngineeringResourceImpact"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "maximum_backup_bytes": {
          "type": "integer"
        },
        "maximum_input_bytes": {
          "type": "integer"
        },
        "migration_assets": {
          "items": {
            "$ref": "#/$defs/PostgreSQLMigrationAsset"
          },
          "type": "array"
        },
        "migration_role": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        },
        "production": {
          "type": "boolean"
        },
        "rollback_required": {
          "type": "boolean"
        },
        "service_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "task_id",
        "candidate_id",
        "environment_id",
        "service_id",
        "approved_changeset_id",
        "exact_host_id",
        "connection_secret_ref",
        "database_name",
        "migration_role",
        "migration_assets",
        "maximum_input_bytes",
        "maximum_backup_bytes",
        "execution_resource_impact",
        "backup_required",
        "rollback_required",
        "production",
        "created_at",
        "expires_at",
        "contract_version"
      ],
      "type": "object"
    },
    "PostgreSQLMigrationAsset": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "destructive": {
          "type": "boolean"
        },
        "forward_path": {
          "type": "string"
        },
        "forward_sha256": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "rollback_path": {
          "type": "string"
        },
        "rollback_sha256": {
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "order",
        "forward_path",
        "forward_sha256",
        "rollback_path",
        "rollback_sha256",
        "destructive"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.postgresql-integration-verification-plan/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.engineering/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/PostgreSQLIntegrationVerificationPlan"
    },
    "schema_id": {
      "const": "fam.core.postgresql-integration-verification-plan/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Candidate-only reversible PostgreSQL migration verification plan",
  "type": "object"
}
