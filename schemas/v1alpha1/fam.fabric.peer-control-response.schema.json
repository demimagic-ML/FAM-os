{
  "$defs": {
    "PeerCapabilityDeclaration": {
      "additionalProperties": false,
      "properties": {
        "capability_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "contract_version": {
          "const": "fam.fabric.peer-state/v1alpha1"
        },
        "declaration_id": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "expert_id": {
          "type": "string"
        },
        "expert_tier": {
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "type": "string"
        },
        "manifest_sha256": {
          "type": "string"
        },
        "maximum_context_bytes": {
          "type": "integer"
        },
        "model_ref": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "signature_base64": {
          "type": "string"
        }
      },
      "required": [
        "declaration_id",
        "device_id",
        "expert_id",
        "model_ref",
        "expert_tier",
        "capability_ids",
        "maximum_context_bytes",
        "manifest_sha256",
        "revision",
        "issued_at",
        "expires_at",
        "signature_base64",
        "contract_version"
      ],
      "type": "object"
    },
    "PeerControlResponse": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/PeerCapabilityDeclaration"
          },
          "type": "array"
        },
        "context_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteContextReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract_version": {
          "const": "fam.fabric.peer-control/v1alpha1"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "peer_certificate_sha256": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "responder_device_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ready"
          ],
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "responder_device_id",
        "status",
        "observed_at",
        "peer_certificate_sha256",
        "capabilities",
        "context_receipt",
        "contract_version"
      ],
      "type": "object"
    },
    "RemoteContextReceipt": {
      "additionalProperties": false,
      "properties": {
        "accepted_at": {
          "format": "date-time",
          "type": "string"
        },
        "content_bytes": {
          "type": "integer"
        },
        "content_sha256": {
          "type": "string"
        },
        "context_id": {
          "type": "string"
        },
        "contract_version": {
          "const": "fam.fabric.minimum-context/v1alpha1"
        },
        "raw_fragment_count": {
          "type": "integer"
        },
        "receipt_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "responder_device_id": {
          "type": "string"
        },
        "sender_device_id": {
          "type": "string"
        },
        "signature_base64": {
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted"
          ],
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "request_id",
        "context_id",
        "sender_device_id",
        "responder_device_id",
        "status",
        "content_bytes",
        "content_sha256",
        "raw_fragment_count",
        "accepted_at",
        "signature_base64",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.fabric.peer-control-response/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.fabric.peer-control/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/PeerControlResponse"
    },
    "schema_id": {
      "const": "fam.fabric.peer-control-response/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Authenticated peer health response",
  "type": "object"
}
