{
  "$defs": {
    "PeerCapabilityDeclaration": {
      "additionalProperties": false,
      "properties": {
        "capability_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "contract_version": {
          "const": "fam.fabric.peer-state/v1alpha1"
        },
        "declaration_id": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "expert_id": {
          "type": "string"
        },
        "expert_tier": {
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "type": "string"
        },
        "manifest_sha256": {
          "type": "string"
        },
        "maximum_context_bytes": {
          "type": "integer"
        },
        "model_ref": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "signature_base64": {
          "type": "string"
        }
      },
      "required": [
        "declaration_id",
        "device_id",
        "expert_id",
        "model_ref",
        "expert_tier",
        "capability_ids",
        "maximum_context_bytes",
        "manifest_sha256",
        "revision",
        "issued_at",
        "expires_at",
        "signature_base64",
        "contract_version"
      ],
      "type": "object"
    },
    "PeerEndpoint": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      },
      "required": [
        "host",
        "port"
      ],
      "type": "object"
    },
    "PeerPerformanceObservation": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "fam.fabric.peer-state/v1alpha1"
        },
        "enrollment_id": {
          "type": "string"
        },
        "observation_id": {
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "peer_certificate_sha256": {
          "type": "string"
        },
        "peer_device_id": {
          "type": "string"
        },
        "response_bytes": {
          "type": "integer"
        },
        "round_trip_milliseconds": {
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "tls_version": {
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "enrollment_id",
        "peer_device_id",
        "round_trip_milliseconds",
        "response_bytes",
        "observed_at",
        "peer_certificate_sha256",
        "tls_version",
        "source",
        "contract_version"
      ],
      "type": "object"
    },
    "PeerPrivacyPolicyRecord": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "fam.fabric.peer-state/v1alpha1"
        },
        "enrollment_id": {
          "type": "string"
        },
        "peer_device_id": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/RemotePrivacyPolicy"
        },
        "revision": {
          "type": "integer"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "enrollment_id",
        "peer_device_id",
        "policy",
        "revision",
        "updated_at",
        "contract_version"
      ],
      "type": "object"
    },
    "RemotePrivacyPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_device_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowed_purpose_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowed_sensitivities": {
          "items": {
            "enum": [
              "public",
              "private",
              "restricted"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "allowed_workspace_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maximum_context_bytes": {
          "type": "integer"
        },
        "owner_id": {
          "type": "string"
        },
        "raw_content_allowed": {
          "type": "boolean"
        }
      },
      "required": [
        "owner_id",
        "allowed_device_ids",
        "allowed_purpose_ids",
        "allowed_workspace_ids",
        "maximum_context_bytes",
        "allowed_sensitivities",
        "raw_content_allowed"
      ],
      "type": "object"
    },
    "TrustedPeerDirectoryEntry": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/PeerCapabilityDeclaration"
          },
          "type": "array"
        },
        "contract_version": {
          "const": "fam.fabric.trusted-peer-directory/v1alpha1"
        },
        "device_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "endpoint": {
          "$ref": "#/$defs/PeerEndpoint"
        },
        "enrollment_id": {
          "type": "string"
        },
        "enrollment_revision": {
          "type": "integer"
        },
        "latest_performance": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeerPerformanceObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "privacy": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeerPrivacyPolicyRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "trusted": {
          "type": "boolean"
        }
      },
      "required": [
        "enrollment_id",
        "enrollment_revision",
        "device_id",
        "display_name",
        "endpoint",
        "capabilities",
        "latest_performance",
        "privacy",
        "trusted",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.fabric.trusted-peer-directory/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.fabric.trusted-peer-directory/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/TrustedPeerDirectoryEntry"
    },
    "schema_id": {
      "const": "fam.fabric.trusted-peer-directory/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Active trusted peer directory entry",
  "type": "object"
}
