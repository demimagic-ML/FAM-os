{
  "$defs": {
    "DesignAsset": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "type": "string"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "media_type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source_asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "media_type",
        "content_sha256",
        "source_asset_id",
        "width",
        "height"
      ],
      "type": "object"
    },
    "DesignAssetManifest": {
      "additionalProperties": false,
      "properties": {
        "accessibility_review_required": {
          "type": "boolean"
        },
        "assets": {
          "items": {
            "$ref": "#/$defs/DesignAsset"
          },
          "type": "array"
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "design_system_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest_id": {
          "type": "string"
        },
        "required_verifier_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "manifest_id",
        "task_id",
        "created_at",
        "design_system_id",
        "assets",
        "required_verifier_ids",
        "accessibility_review_required",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.design-assets/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.engineering/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/DesignAssetManifest"
    },
    "schema_id": {
      "const": "fam.core.design-assets/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Verified design asset manifest",
  "type": "object"
}
