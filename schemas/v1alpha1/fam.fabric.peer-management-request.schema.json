{
  "$defs": {
    "PeerManagementRequest": {
      "additionalProperties": false,
      "properties": {
        "confirmed": {
          "type": "boolean"
        },
        "contract_version": {
          "const": "fam.fabric.peer-state/v1alpha1"
        },
        "enrollment_id": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer"
        },
        "operation": {
          "enum": [
            "revoke",
            "set_privacy"
          ],
          "type": "string"
        },
        "owner_id": {
          "type": "string"
        },
        "privacy_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemotePrivacyPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "owner_id",
        "operation",
        "enrollment_id",
        "expected_revision",
        "confirmed",
        "reason_code",
        "privacy_policy",
        "contract_version"
      ],
      "type": "object"
    },
    "RemotePrivacyPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_device_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowed_purpose_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowed_sensitivities": {
          "items": {
            "enum": [
              "public",
              "private",
              "restricted"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "allowed_workspace_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maximum_context_bytes": {
          "type": "integer"
        },
        "owner_id": {
          "type": "string"
        },
        "raw_content_allowed": {
          "type": "boolean"
        }
      },
      "required": [
        "owner_id",
        "allowed_device_ids",
        "allowed_purpose_ids",
        "allowed_workspace_ids",
        "maximum_context_bytes",
        "allowed_sensitivities",
        "raw_content_allowed"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.fabric.peer-management-request/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.fabric.peer-state/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/PeerManagementRequest"
    },
    "schema_id": {
      "const": "fam.fabric.peer-management-request/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Confirmed peer control request",
  "type": "object"
}
