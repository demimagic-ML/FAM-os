{
  "$defs": {
    "PeerCapabilityDeclaration": {
      "additionalProperties": false,
      "properties": {
        "capability_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "contract_version": {
          "const": "fam.fabric.peer-state/v1alpha1"
        },
        "declaration_id": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "expert_id": {
          "type": "string"
        },
        "expert_tier": {
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "type": "string"
        },
        "manifest_sha256": {
          "type": "string"
        },
        "maximum_context_bytes": {
          "type": "integer"
        },
        "model_ref": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "signature_base64": {
          "type": "string"
        }
      },
      "required": [
        "declaration_id",
        "device_id",
        "expert_id",
        "model_ref",
        "expert_tier",
        "capability_ids",
        "maximum_context_bytes",
        "manifest_sha256",
        "revision",
        "issued_at",
        "expires_at",
        "signature_base64",
        "contract_version"
      ],
      "type": "object"
    },
    "PeerEndpoint": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      },
      "required": [
        "host",
        "port"
      ],
      "type": "object"
    },
    "PeerManagementReceipt": {
      "additionalProperties": false,
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "before_revision": {
          "type": "integer"
        },
        "contract_version": {
          "const": "fam.fabric.peer-state/v1alpha1"
        },
        "enrollment_id": {
          "type": "string"
        },
        "local_only": {
          "type": "boolean"
        },
        "operation": {
          "enum": [
            "revoke",
            "set_privacy"
          ],
          "type": "string"
        },
        "owner_id": {
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "receipt_id": {
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "request_sha256": {
          "type": "string"
        },
        "resulting_revision": {
          "type": "integer"
        }
      },
      "required": [
        "receipt_id",
        "request_id",
        "owner_id",
        "operation",
        "enrollment_id",
        "request_sha256",
        "before_revision",
        "resulting_revision",
        "applied",
        "reason_codes",
        "recorded_at",
        "local_only",
        "contract_version"
      ],
      "type": "object"
    },
    "PeerPerformanceObservation": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "fam.fabric.peer-state/v1alpha1"
        },
        "enrollment_id": {
          "type": "string"
        },
        "observation_id": {
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "peer_certificate_sha256": {
          "type": "string"
        },
        "peer_device_id": {
          "type": "string"
        },
        "response_bytes": {
          "type": "integer"
        },
        "round_trip_milliseconds": {
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "tls_version": {
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "enrollment_id",
        "peer_device_id",
        "round_trip_milliseconds",
        "response_bytes",
        "observed_at",
        "peer_certificate_sha256",
        "tls_version",
        "source",
        "contract_version"
      ],
      "type": "object"
    },
    "PeerPrivacyPolicyRecord": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "fam.fabric.peer-state/v1alpha1"
        },
        "enrollment_id": {
          "type": "string"
        },
        "peer_device_id": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/RemotePrivacyPolicy"
        },
        "revision": {
          "type": "integer"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "enrollment_id",
        "peer_device_id",
        "policy",
        "revision",
        "updated_at",
        "contract_version"
      ],
      "type": "object"
    },
    "RemoteContextDisclosureEvidence": {
      "additionalProperties": false,
      "properties": {
        "capability_declaration_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_bytes": {
          "type": "integer"
        },
        "content_sha256": {
          "type": "string"
        },
        "context_id": {
          "type": "string"
        },
        "contract_version": {
          "const": "fam.fabric.minimum-context/v1alpha1"
        },
        "direction": {
          "enum": [
            "outbound",
            "inbound"
          ],
          "type": "string"
        },
        "enrollment_id": {
          "type": "string"
        },
        "evidence_id": {
          "type": "string"
        },
        "local_only": {
          "type": "boolean"
        },
        "peer_device_id": {
          "type": "string"
        },
        "privacy_policy_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "purpose_id": {
          "type": "string"
        },
        "raw_fragment_sha256": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "receipt": {
          "$ref": "#/$defs/RemoteContextReceipt"
        },
        "recorded_at": {
          "format": "date-time",
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "request_sha256": {
          "type": "string"
        },
        "sensitivity": {
          "enum": [
            "public",
            "private",
            "restricted"
          ],
          "type": "string"
        },
        "target_expert_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "request_id",
        "request_sha256",
        "enrollment_id",
        "peer_device_id",
        "direction",
        "context_id",
        "target_expert_id",
        "purpose_id",
        "workspace_id",
        "sensitivity",
        "content_bytes",
        "content_sha256",
        "raw_fragment_sha256",
        "privacy_policy_revision",
        "capability_declaration_id",
        "receipt",
        "reason_codes",
        "recorded_at",
        "local_only",
        "contract_version"
      ],
      "type": "object"
    },
    "RemoteContextReceipt": {
      "additionalProperties": false,
      "properties": {
        "accepted_at": {
          "format": "date-time",
          "type": "string"
        },
        "content_bytes": {
          "type": "integer"
        },
        "content_sha256": {
          "type": "string"
        },
        "context_id": {
          "type": "string"
        },
        "contract_version": {
          "const": "fam.fabric.minimum-context/v1alpha1"
        },
        "raw_fragment_count": {
          "type": "integer"
        },
        "receipt_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "responder_device_id": {
          "type": "string"
        },
        "sender_device_id": {
          "type": "string"
        },
        "signature_base64": {
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted"
          ],
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "request_id",
        "context_id",
        "sender_device_id",
        "responder_device_id",
        "status",
        "content_bytes",
        "content_sha256",
        "raw_fragment_count",
        "accepted_at",
        "signature_base64",
        "contract_version"
      ],
      "type": "object"
    },
    "RemotePrivacyPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_device_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowed_purpose_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowed_sensitivities": {
          "items": {
            "enum": [
              "public",
              "private",
              "restricted"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "allowed_workspace_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maximum_context_bytes": {
          "type": "integer"
        },
        "owner_id": {
          "type": "string"
        },
        "raw_content_allowed": {
          "type": "boolean"
        }
      },
      "required": [
        "owner_id",
        "allowed_device_ids",
        "allowed_purpose_ids",
        "allowed_workspace_ids",
        "maximum_context_bytes",
        "allowed_sensitivities",
        "raw_content_allowed"
      ],
      "type": "object"
    },
    "ShellPeerResponse": {
      "additionalProperties": false,
      "properties": {
        "context_evidence": {
          "items": {
            "$ref": "#/$defs/RemoteContextDisclosureEvidence"
          },
          "type": "array"
        },
        "contract_version": {
          "const": "fam.shell.peer/v1alpha1"
        },
        "control_receipts": {
          "items": {
            "$ref": "#/$defs/PeerManagementReceipt"
          },
          "type": "array"
        },
        "offset": {
          "type": "integer"
        },
        "operation": {
          "enum": [
            "peers",
            "probe",
            "receipts",
            "context",
            "context_evidence"
          ],
          "type": "string"
        },
        "peers": {
          "items": {
            "$ref": "#/$defs/TrustedPeerDirectoryEntry"
          },
          "type": "array"
        },
        "request_id": {
          "type": "string"
        },
        "total_count": {
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "operation",
        "offset",
        "total_count",
        "peers",
        "control_receipts",
        "context_evidence",
        "contract_version"
      ],
      "type": "object"
    },
    "TrustedPeerDirectoryEntry": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/PeerCapabilityDeclaration"
          },
          "type": "array"
        },
        "contract_version": {
          "const": "fam.fabric.trusted-peer-directory/v1alpha1"
        },
        "device_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "endpoint": {
          "$ref": "#/$defs/PeerEndpoint"
        },
        "enrollment_id": {
          "type": "string"
        },
        "enrollment_revision": {
          "type": "integer"
        },
        "latest_performance": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeerPerformanceObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "privacy": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeerPrivacyPolicyRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "trusted": {
          "type": "boolean"
        }
      },
      "required": [
        "enrollment_id",
        "enrollment_revision",
        "device_id",
        "display_name",
        "endpoint",
        "capabilities",
        "latest_performance",
        "privacy",
        "trusted",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.shell.peer-response/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.shell.peer/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/ShellPeerResponse"
    },
    "schema_id": {
      "const": "fam.shell.peer-response/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Bounded Shell trusted peer response",
  "type": "object"
}
