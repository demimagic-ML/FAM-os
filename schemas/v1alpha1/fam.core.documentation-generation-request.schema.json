{
  "$defs": {
    "DocumentationGenerationRequest": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "generator_recipe_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "diagram",
            "api_reference",
            "runbook",
            "changelog",
            "generated_code"
          ],
          "type": "string"
        },
        "output_path": {
          "type": "string"
        },
        "ownership_path": {
          "type": "string"
        },
        "regeneration_instruction_path": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/DocumentationSource"
          },
          "type": "array"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "task_id",
        "candidate_id",
        "kind",
        "output_path",
        "generator_recipe_id",
        "ownership_path",
        "regeneration_instruction_path",
        "sources",
        "created_at",
        "contract_version"
      ],
      "type": "object"
    },
    "DocumentationSource": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "content_sha256"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.documentation-generation-request/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.engineering/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/DocumentationGenerationRequest"
    },
    "schema_id": {
      "const": "fam.core.documentation-generation-request/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Candidate-bound governed generated-content request",
  "type": "object"
}
