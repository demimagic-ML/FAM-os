{
  "$defs": {
    "DeviceIdentity": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "fingerprint_sha256": {
          "type": "string"
        },
        "public_key_base64": {
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "display_name",
        "public_key_base64",
        "fingerprint_sha256"
      ],
      "type": "object"
    },
    "DevicePairingOffer": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "fam.fabric.device-pairing/v1alpha1"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "endpoint": {
          "$ref": "#/$defs/PeerEndpoint"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/DeviceIdentity"
        },
        "identity_certificate_base64": {
          "type": "string"
        },
        "nonce_base64": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "signature_base64": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "identity",
        "identity_certificate_base64",
        "endpoint",
        "nonce_base64",
        "created_at",
        "expires_at",
        "signature_base64",
        "contract_version"
      ],
      "type": "object"
    },
    "PeerEndpoint": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      },
      "required": [
        "host",
        "port"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.fabric.pairing-offer/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.fabric.device-pairing/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/DevicePairingOffer"
    },
    "schema_id": {
      "const": "fam.fabric.pairing-offer/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Signed expiring device pairing offer",
  "type": "object"
}
