{
  "$defs": {
    "DependencyResolutionBudget": {
      "additionalProperties": false,
      "properties": {
        "maximum_download_bytes": {
          "type": "integer"
        },
        "maximum_installed_bytes": {
          "type": "integer"
        },
        "maximum_packages": {
          "type": "integer"
        },
        "maximum_wall_seconds": {
          "type": "integer"
        }
      },
      "required": [
        "maximum_packages",
        "maximum_download_bytes",
        "maximum_installed_bytes",
        "maximum_wall_seconds"
      ],
      "type": "object"
    },
    "DependencyResolutionRequest": {
      "additionalProperties": false,
      "properties": {
        "allowed_license_expressions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "approved_at": {
          "format": "date-time",
          "type": "string"
        },
        "authorities": {
          "items": {
            "enum": [
              "observe",
              "propose",
              "modify",
              "execute",
              "network",
              "publish",
              "raw_shell",
              "host_admin",
              "secret_use",
              "global_install",
              "production_mutate",
              "policy_change",
              "protected_ref_write",
              "self_update"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "budget": {
          "$ref": "#/$defs/DependencyResolutionBudget"
        },
        "candidate_id": {
          "type": "string"
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "ecosystem": {
          "type": "string"
        },
        "environment_path": {
          "type": "string"
        },
        "global_install": {
          "type": "boolean"
        },
        "host_toolchain_mutation": {
          "type": "boolean"
        },
        "lockfile_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "manifest_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "network_hosts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "registry_urls": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "request_id": {
          "type": "string"
        },
        "requested_packages": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "task_id",
        "candidate_id",
        "ecosystem",
        "manifest_paths",
        "lockfile_paths",
        "registry_urls",
        "network_hosts",
        "allowed_license_expressions",
        "budget",
        "environment_path",
        "approved_at",
        "authorities",
        "requested_packages",
        "global_install",
        "host_toolchain_mutation",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.core.dependency-resolution-request/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.core.engineering/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/DependencyResolutionRequest"
    },
    "schema_id": {
      "const": "fam.core.dependency-resolution-request/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Approved isolated dependency resolution request",
  "type": "object"
}
