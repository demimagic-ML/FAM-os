{
  "$defs": {
    "GitPublicationApproval": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "type": "string"
        },
        "approved_at": {
          "format": "date-time",
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "commit_object_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "complete_diff_sha256": {
          "type": "string"
        },
        "consequence_preview": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "contract_version": {
          "const": "fam.core.engineering/v1alpha1"
        },
        "credential_ref": {
          "type": "string"
        },
        "expected_old_object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "grant_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "push",
            "draft_change_request",
            "force_push",
            "protected_ref_write",
            "tag_ref_change",
            "remote_change"
          ],
          "type": "string"
        },
        "proposed_new_object_id": {
          "type": "string"
        },
        "remote_name": {
          "type": "string"
        },
        "remote_url_sha256": {
          "type": "string"
        },
        "repository_root": {
          "type": "string"
        },
        "single_use": {
          "type": "boolean"
        },
        "source_ref": {
          "type": "string"
        },
        "target_ref": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "verification_evidence_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "approval_id",
        "task_id",
        "grant_id",
        "kind",
        "repository_root",
        "remote_name",
        "remote_url_sha256",
        "source_ref",
        "target_ref",
        "expected_old_object_id",
        "proposed_new_object_id",
        "commit_object_ids",
        "complete_diff_sha256",
        "verification_evidence_ids",
        "title",
        "body",
        "credential_ref",
        "consequence_preview",
        "approved_at",
        "expires_at",
        "single_use",
        "contract_version"
      ],
      "type": "object"
    },
    "ShellEngineeringPublicationRequest": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "$ref": "#/$defs/GitPublicationApproval"
        },
        "confirmed": {
          "type": "boolean"
        },
        "contract_version": {
          "const": "fam.shell.engineering-loop/v1alpha1"
        },
        "owner_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "owner_id",
        "task_id",
        "approval",
        "confirmed",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.fam-os.local/fam.shell.engineering-publication/v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "fam.shell.engineering-loop/v1alpha1"
    },
    "payload": {
      "$ref": "#/$defs/ShellEngineeringPublicationRequest"
    },
    "schema_id": {
      "const": "fam.shell.engineering-publication/v1alpha1"
    }
  },
  "required": [
    "schema_id",
    "contract_version",
    "payload"
  ],
  "title": "Exact separately granted Git publication request",
  "type": "object"
}
